# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat NIET in git, zodat geheimen nooit online komen.

# --- Supabase (database, login, opslag) -------------------------------------
# Te vinden in Supabase via de knop "Connect" (Project URL en Publishable key). Kies een EU-regio.
# Deze twee mogen in de browser: de publishable key geeft alleen toegang via Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GEHEIM ("secret key" of "service_role"). Alleen op de server. Nooit NEXT_PUBLIC_ ervoor zetten.
SUPABASE_SECRET_KEY=

# --- AI (fase 3) -------------------------------------------------------------
# GEHEIM. Wordt alleen door de server gebruikt.
ANTHROPIC_API_KEY=
# Spraak-naar-tekst: leverancier en sleutel, kiezen we in fase 3.
STT_PROVIDER=
STT_API_KEY=

# --- Limieten en privacy -----------------------------------------------------
# Maximaal aantal AI-aanroepen per gebruiker per dag.
AI_CALLS_PER_USER_PER_DAY=50

# --- App ---------------------------------------------------------------------
# Adres van de app, gebruikt in deelbare offertelinks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alleen voor testen op je eigen computer zonder AI-sleutel: zet op "demo".
# De app gebruikt dan altijd hetzelfde voorbeeldantwoord en toont een DEMO-melding. Werkt nooit in productie.
AI_PROVIDER=
